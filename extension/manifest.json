{
  "manifest_version": 3,
  "name": "쇼더스 대본 판정 (비공식 프로토타입)",
  "version": "0.1.0",
  "description": "쇼더스 Studio 2단계 대본을 렌더 전에 판정해 점수와 다시 만들 섹션을 보여 줍니다. 이 PC에서 실행하는 로컬 판정 서버가 필요한 비공식 도구입니다.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shortus.viewus.co.kr/studio/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ]
}
