# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 저장소에 올라가지 않는다.
# 값은 Claude Console의 Workload identity 화면에서 확인한다(docs/wif-setup.md).

ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# 규칙이 워크스페이스를 둘 이상 덮을 때만 필요
ANTHROPIC_WORKSPACE_ID=

# Google Cloud 서비스 계정으로 신원 토큰을 받는 명령(한 줄)
JUDGE_IDENTITY_TOKEN_COMMAND=gcloud auth print-identity-token --impersonate-service-account=shortus-judge@PROJECT_ID.iam.gserviceaccount.com --audiences=https://api.anthropic.com --include-email
